{
  "name": "EDH Club",
  "short_name": "EDH Club",
  "description": "Free Commander games in your browser. Bring your deck, sit at the table, play with friends or bots.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#06080d",
  "theme_color": "#06080d",
  "lang": "en",
  "categories": ["games", "entertainment"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Practice vs bots", "url": "/table.html?mode=bots", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Top 100 decks", "url": "/decks.html", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
