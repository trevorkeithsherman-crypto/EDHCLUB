// Cloudflare Worker for EDH Club: static assets from ./dist plus a small /api for the Top 100 decks page.
// Build with `npm run build`, then `npx wrangler deploy`.
{
  "name": "edhclub",
  "main": "worker.js",
  "compatibility_date": "2026-09-05",
  // Every 5 minutes: announce new open public tables to Discord (needs the secrets described in worker.js).
  "triggers": { "crons": ["*/5 * * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
